# Use a small and fast Python 3.12 image
FROM python:3.12-slim

# Set working directory
WORKDIR /app

# Install system-level dependencies (optional but safe)
RUN apt-get update && apt-get install -y \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy everything to the container
COPY . .

# Expose port (Amplify uses 8080 internally)
EXPOSE 8080

# Run Streamlit app
CMD ["streamlit", "run", "dashboard/app.py", "--server.port=8080", "--server.address=0.0.0.0"]